<Project>
  <PropertyGroup>
    <ProjectName>CameraTweaks</ProjectName>

    <!-- E.g. <BaseGamePath>C:\Some\Path\To\Your\Game\Folder</ManualBaseGamePath> -->
    <BaseGamePath>../../../</BaseGamePath>
  </PropertyGroup>

  <PropertyGroup>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(BaseGamePath)\BepInEx</BepInExDir>
    <GameAssembliesDir Condition="'$(GameAssembliesDir)' == ''">$(BaseGamePath)\Gunsaw_Data\Managed</GameAssembliesDir>
  </PropertyGroup>
</Project>
